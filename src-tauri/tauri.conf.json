{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Vault Local",
  "version": "0.5.0",
  "identifier": "com.vaultlocal.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vault Local",
        "width": 1400,
        "height": 900,
        "center": true,
        "visible": false,
        "minWidth": 1100,
        "minHeight": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QzU2N0RCQTJGRTE3MDcKUldRSEYvNmkyMmZGMWpnRXMwRmFVNWpNNUsydUdOVWNyVUZtc2xxVEF4SEEzcy8xdmpGRis5ZjgK",
      "endpoints": [
        "https://github.com/od1n/vault-local/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
